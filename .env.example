# Obrigatória na Vercel. Nunca faça commit da chave real.
GEMINI_API_KEY=

# Modelos estáveis padrão. O código funciona sem declarar estas duas variáveis.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Opcionais de operação.
# Tempo em que o modelo secundário fica prioritário após sobrecarga do principal.
GEMINI_PRIMARY_COOLDOWN_MS=120000
# Limite best-effort de mensagens por minuto por IP em cada instância serverless.
CHAT_RATE_LIMIT_MAX=8

# Formulário criativo de contato por e-mail (Resend).
# Recomendado usar um domínio verificado no Resend para o remetente.
RESEND_API_KEY=
CONTACT_TO_EMAIL=wagnerpersoli@hotmail.com
CONTACT_FROM_EMAIL=WAGNER.OS <onboarding@resend.dev>
CONTACT_RATE_LIMIT_MAX=5
CONTACT_MAX_BODY_BYTES=16384
