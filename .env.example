# Copie para .env.local somente no computador local. Nunca compacte nem faça commit.

# Chat Gemini (somente backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_PRIMARY_COOLDOWN_MS=120000
CHAT_RATE_LIMIT_MAX=20
CHAT_MAX_BODY_BYTES=32768

# Supabase Data API com chave pública protegida por RLS INSERT-only.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
# Compatibilidade temporária com chaves legadas, se necessário:
SUPABASE_ANON_KEY=
CONTACT_REQUIRE_SUPABASE=true

# Provedor recomendado em produção: Brevo (somente backend).
CONTACT_EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_NAME=WAGNER.OS
BREVO_SENDER_EMAIL=contato@seudominio.com
CONTACT_TO_EMAIL=wagnerpersoli@hotmail.com
CONTACT_FROM_EMAIL=

# Compatibilidade opcional com Resend.
RESEND_API_KEY=

# Contato / segurança / timeout
CONTACT_RATE_LIMIT_MAX=5
CONTACT_MAX_BODY_BYTES=16384
CONTACT_PROVIDER_TIMEOUT_MS=9000

# Rate limit distribuído. Sem estes valores, desenvolvimento usa memória local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HASH_SALT=

# Origens extras separadas por vírgula. Produção e aliases oficiais já são aceitos.
ALLOWED_ORIGINS=https://wagnerpersoli.vercel.app
